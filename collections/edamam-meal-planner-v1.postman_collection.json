            "body": {
              "mode": "raw",
              "raw": "{\n  \"size\": 1,\n  \"plan\": {\n    \"accept\": {\n      \"all\": [\n        {\n          \"value\": \"<Circular reference to #/components/schemas/Predicate detected>\"\n        },\n        {\n          \"value\": \"<Circular reference to #/components/schemas/Predicate detected>\"\n        }\n      ]\n    },\n    \"fit\": {\n      \"key_0\": {\n        \"min\": \"<number>\",\n        \"max\": \"<number>\"\n      }\n    },\n    \"exclude\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"sections\": {\n      \"key_0\": {\n        \"value\": \"<Circular reference to #/components/schemas/Section detected>\"\n      },\n      \"key_1\": {\n        \"value\": \"<Circular reference to #/components/schemas/Section detected>\"\n      }\n    }\n  },\n  \"selection\": [\n    {\n      \"assigned\": \"<string>\",\n      \"_links\": {\n        \"self\": {\n          \"href\": \"<string>\",\n          \"title\": \"<string>\"\n        }\n      },\n      \"sections\": {\n        \"key_0\": {\n          \"value\": \"<Circular reference to #/components/schemas/Selection detected>\"\n        }\n      }\n    },\n    {\n      \"assigned\": \"<string>\",\n      \"_links\": {\n        \"self\": {\n          \"href\": \"<string>\",\n          \"title\": \"<string>\"\n        }\n      },\n      \"sections\": {\n        \"key_0\": {\n          \"value\": \"<Circular reference to #/components/schemas/Selection detected>\"\n        }\n      }\n    }\n  ]\n}",
